{
	email {$ACME_EMAIL}
	servers {
		# Trust nothing upstream of Caddy; it is the edge.
		protocols h1 h2 h3
	}
}

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Service-to-service callbacks must never be reachable from the Internet.
	@internal path /api/v1/internal/*
	respond @internal 404

	handle /api/* {
		reverse_proxy {
			# Re-resolve Docker DNS so every go-api replica receives traffic,
			# including replicas added later with `--scale go-api=N`.
			dynamic a {
				name go-api
				port 8080
				refresh 5s
			}
			lb_policy least_conn
			lb_try_duration 5s
			lb_try_interval 250ms

			# Passive health checking: eject a replica for 30s after failures.
			fail_duration 30s
			max_fails 3
			unhealthy_status 502 503 504

			transport http {
				dial_timeout 3s
				response_header_timeout 15s
				keepalive 90s
				keepalive_idle_conns 512
			}
		}
	}

	handle {
		respond "TaskFlow API" 200
	}

	log {
		output stdout
		format json
	}
}
